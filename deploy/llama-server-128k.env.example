# 128K context for Qwen3.6-35B-A3B on llama-server. NOT applied: merge these lines into /etc/default/llama-server
# by hand (sudo) after reading docs/context-128k.md, then restart llama-server and benchmark.
#
# Only 10 of 40 layers keep a KV cache (the rest are Gated DeltaNet), so f16 KV grows ~640 MiB per 32K:
# 32K ≈ 0.6 GiB, 128K ≈ 2.5 GiB. Keep f16 K/V (DFlash2 + RDNA3 need F16 for the MMA flash-attention kernel).
LLAMA_CTX=131072
LLAMA_SLOTS=1
LLAMA_CACHE_K=
LLAMA_CACHE_V=
# ~2 GiB more GTT in use at full context: give the start guard a little more headroom.
LLAMA_GUARD_MIN_AVAIL_GB=28
LLAMA_GUARD_MAX_GTT_GB=12
