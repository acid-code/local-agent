# local-agent configuration.
# Copy to .env for docker compose or a host install. Never commit .env.
#
# Leave LA_PASSWORD unset to create the owner account in the browser.
# LA_PASSWORD=
LA_HOST=0.0.0.0
LA_PORT=8787
DATA_DIR=./data

# LAN-only setup site. Refuses Tailscale (100.64.0.0/10) and public addresses.
# LA_SETUP_PORT=8788
# Extra CIDRs, comma-separated. Do not add the tailnet unless you mean to.
# LA_SETUP_ALLOW=

# Optional cloud providers. The names are what the UI expects.
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Optional overrides.
# OLLAMA_HOST=http://127.0.0.1:11434
# Fallback context if a request omits num_ctx. The app sends each model's practical budget.
# OLLAMA_CONTEXT_LENGTH=32768
# DOCKER_SOCKET=/var/run/docker.sock
# SEARXNG_URL=http://127.0.0.1:8088
